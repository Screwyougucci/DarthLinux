#!/usr/bin/env python3
"""Darth Settings: audio, display, camera, media, network and system controls."""
import shutil
import subprocess
import threading
from pathlib import Path
import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, Gio, GLib, Gdk

def command(args, timeout=4):
    try:
        p = subprocess.run(args, text=True, capture_output=True, timeout=timeout, check=False)
        return p.returncode, (p.stdout or p.stderr).strip()
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 1, str(exc)

def launch(args):
    try:
        subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except OSError as exc:
        return False, str(exc)

class DarthSettings(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.darthlinux.Settings",
                         flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        css = Gtk.CssProvider()
        css.load_from_data(b"""
          window.darth { background: #101116; color: #eeeeF4; }
          .darth label { color: #eeeeF4; }
          .darth .title-1 { color: #f04452; font-weight: 800; }
          .darth .dim { color: #a9a9b4; }
          .darth button { background: #20232c; color: #f4f4f6;
            border: 1px solid #7e2631; border-radius: 9px; padding: 9px; }
          .darth button:hover { background: #38212a; border-color: #ff4655; }
          .darth .panel { background: #191c24; border: 1px solid #44404a;
            border-radius: 10px; padding: 14px; }
        """)
        display = Gdk.Display.get_default()
        if display:
            Gtk.StyleContext.add_provider_for_display(display, css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        win = Gtk.ApplicationWindow(application=self)
        win.set_icon_name("darth-linux")
        win.add_css_class("darth")
        release_file = Path("/etc/darth-linux-release")
        release = release_file.read_text(encoding="utf-8").strip() if release_file.exists() else "0.5"
        win.set_title(f"Darth Linux {release} // System Settings")
        win.set_default_size(900, 720)
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        outer.set_margin_top(20); outer.set_margin_bottom(20)
        outer.set_margin_start(22); outer.set_margin_end(22)
        win.set_child(outer)

        heading = Gtk.Label(label=f"DARTH LINUX {release}  //  SYSTEM SETTINGS")
        heading.add_css_class("title-1"); heading.set_halign(Gtk.Align.START)
        outer.append(heading)
        sub = Gtk.Label(label="CONTROL YOUR HARDWARE, MEDIA, CONNECTIVITY, UPDATES AND SECURITY")
        sub.add_css_class("dim"); sub.set_halign(Gtk.Align.START); outer.append(sub)

        pages = Gtk.Notebook()
        pages.set_vexpand(True)
        outer.append(pages)

        def page(name):
            scroller = Gtk.ScrolledWindow()
            scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            box.set_margin_top(16); box.set_margin_bottom(16)
            box.set_margin_start(16); box.set_margin_end(16)
            scroller.set_child(box)
            pages.append_page(scroller, Gtk.Label(label=name))
            return box

        def section(parent, title, detail=None):
            panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            panel.add_css_class("panel")
            label = Gtk.Label(label=title); label.set_halign(Gtk.Align.START)
            label.add_css_class("heading"); panel.append(label)
            if detail:
                d = Gtk.Label(label=detail); d.set_wrap(True); d.set_xalign(0)
                d.add_css_class("dim"); panel.append(d)
            parent.append(panel)
            return panel

        def action(parent, label, args, description=None):
            b = Gtk.Button(label=label)
            b.set_halign(Gtk.Align.START)
            b.connect("clicked", lambda *_: self.do_launch(args))
            parent.append(b)
            if description:
                d = Gtk.Label(label=description); d.set_xalign(0); d.set_wrap(True)
                d.add_css_class("dim"); parent.append(d)
            return b

        def media_controls(parent):
            transport = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            for label, verb in [("Previous", "previous"), ("Play / Pause", "play-pause"), ("Next", "next")]:
                button = Gtk.Button(label=label)
                button.connect("clicked", lambda _button, action=verb: launch(["playerctl", action]))
                transport.append(button)
            parent.append(transport)

        # Audio
        audio = page("Audio")
        a = section(audio, "OUTPUT VOLUME", "Adjust the default PipeWire/PulseAudio output. Changes apply immediately.")
        vol_label = Gtk.Label(label="Volume"); vol_label.set_halign(Gtk.Align.START); a.append(vol_label)
        volume = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 150, 1)
        volume.set_draw_value(True); volume.set_value(50); a.append(volume)
        muted = {"value": False, "updating": False}
        volume_pending = {"source": 0}
        volume.set_sensitive(False)
        mute = Gtk.Button(label="Mute")
        mute.set_sensitive(False)
        def set_no_output():
            vol_label.set_text("No default audio output detected")
            volume.set_sensitive(False)
            mute.set_sensitive(False)
            return False
        def apply_volume(value, is_muted):
            vol_label.set_text("OUTPUT VOLUME")
            volume.set_sensitive(True)
            mute.set_sensitive(True)
            muted["updating"] = True
            volume.set_value(min(150, max(0, value)))
            muted["updating"] = False
            muted["value"] = is_muted
            mute.set_label("Unmute" if is_muted else "Mute")
            return False
        def read_volume(*_):
            def worker():
                rc, out = command(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])
                value = None
                is_muted = False
                if rc == 0:
                    try:
                        value = float(out.split()[1]) * 100
                        is_muted = "[MUTED]" in out
                    except (IndexError, ValueError):
                        pass
                if value is not None:
                    GLib.idle_add(apply_volume, value, is_muted)
                else:
                    GLib.idle_add(set_no_output)
            threading.Thread(target=worker, daemon=True).start()
        def apply_volume_change(value):
            volume_pending["source"] = 0
            try:
                subprocess.Popen(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", value],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except OSError:
                pass
            return False
        def set_volume(scale):
            if muted["updating"]:
                return
            if volume_pending["source"]:
                GLib.source_remove(volume_pending["source"])
            value = f"{scale.get_value()/100:.2f}"
            volume_pending["source"] = GLib.timeout_add(
                160, apply_volume_change, value
            )
        def toggle_mute(*_):
            try:
                subprocess.Popen(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                GLib.timeout_add(350, read_volume)
            except OSError:
                pass
        volume.connect("value-changed", set_volume)
        volume.connect("map", read_volume)
        mute.connect("clicked", toggle_mute)
        a.append(mute)
        refresh_audio = Gtk.Button(label="Refresh audio devices")
        refresh_audio.connect("clicked", read_volume)
        a.append(refresh_audio)
        media_controls(a)
        action(a, "Open advanced audio mixer", ["pavucontrol"], "Choose output devices, input devices, per-app volume and profiles.")
        action(a, "Open XFCE sound settings", ["xfce4-settings-manager"])

        mic = section(audio, "MICROPHONE / INPUT", "Input device selection and microphone levels are managed by the audio mixer.")
        action(mic, "Configure microphones and input levels", ["pavucontrol"])
        action(mic, "List audio devices", ["xfce4-terminal", "--command", "bash -lc 'wpctl status; exec bash'"])

        # Display
        display_page = page("Display")
        d = section(display_page, "MONITORS AND RESOLUTION", "Open XFCE's display panel to configure resolution, refresh rate, rotation and multi-monitor layout.")
        action(d, "Open display settings", ["xfce4-display-settings"])
        bright = section(display_page, "SCREEN BRIGHTNESS", "Brightness controls require a supported laptop backlight device and permissions.")
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        bright.append(row)
        down = Gtk.Button(label="− 5%"); up = Gtk.Button(label="+ 5%")
        down.connect("clicked", lambda *_: launch(["brightnessctl", "set", "5%-"]))
        up.connect("clicked", lambda *_: launch(["brightnessctl", "set", "5%+"]))
        row.append(down); row.append(up)
        action(bright, "Show brightness devices", ["xfce4-terminal", "--command", "bash -lc 'brightnessctl; exec bash'"])

        # Video and camera
        video = page("Video")
        v = section(video, "VIDEO PLAYBACK", "Play local video and audio files with MPV. No media is uploaded.")
        media_controls(v)
        action(v, "Open MPV media player", ["mpv"])
        action(v, "Open file manager", ["thunar"])
        cam = section(video, "WEBCAM / CAMERA", "Inspect and adjust supported USB camera controls. Camera availability depends on hardware and permissions.")
        action(cam, "Open webcam controls", ["guvcview"])
        action(cam, "List camera devices", ["xfce4-terminal", "--command", "bash -lc 'v4l2-ctl --list-devices; exec bash'"])
        action(cam, "Inspect camera controls", ["xfce4-terminal", "--command", "bash -lc 'for d in /dev/video*; do [ -e \"$d\" ] && v4l2-ctl -d \"$d\" --list-ctrls; done; exec bash'"])
        codec = section(video, "VIDEO TOOLS", "FFmpeg provides local media inspection and conversion tools.")
        action(codec, "Open FFmpeg help", ["xfce4-terminal", "--command", "bash -lc 'ffmpeg -hide_banner -formats | head -50; exec bash'"])

        # Network
        network = page("Network")
        n = section(network, "NETWORK CONNECTIONS", "Manage Wi-Fi, Ethernet, VPN profiles and connection priorities.")
        action(n, "Open NetworkManager connections", ["nm-connection-editor"])
        action(n, "Show network status", ["xfce4-terminal", "--command", "bash -lc 'nmcli device status; echo; ip -brief address; exec bash'"])
        action(n, "Open Darth Proxy", ["darth-proxy"])

        # Security
        security = page("Security")
        s = section(security, "DEFENSE AND FIREWALL", "Review local security status and run on-demand scans.")
        action(s, "Open security dashboard", ["xfce4-terminal", "--command", "darth-center"])
        action(s, "Run antivirus scanner", ["xfce4-terminal", "--hold", "--command", "darth-av-scan"])
        action(s, "Open authorized lab scanner", ["xfce4-terminal", "--hold", "--command", "darth-scope-scan"])
        action(s, "Firewall status", ["xfce4-terminal", "--command", "bash -lc 'systemctl status nftables --no-pager; exec bash'"])

        # Updates — safe preview first, explicit administrator approval to install.
        updates = page("Updates")
        update_panel = section(
            updates, "DARTH UPDATE CENTER",
            "Check official Arch repository updates safely, review the package list, then approve a complete system upgrade. "
            "System updates require administrator authentication. Keep the computer connected to power."
        )
        update_status = Gtk.Label(label="Ready to check for updates.")
        update_status.set_xalign(0)
        update_status.set_wrap(True)
        update_panel.append(update_status)
        update_details = Gtk.TextView()
        update_details.set_editable(False)
        update_details.set_cursor_visible(False)
        update_details.set_monospace(True)
        update_details.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        update_details.set_size_request(-1, 150)
        detail_scroll = Gtk.ScrolledWindow()
        detail_scroll.set_min_content_height(150)
        detail_scroll.set_child(update_details)
        update_panel.append(detail_scroll)
        update_state = {"busy": False, "system_updates": False}

        def show_update_output(text):
            update_details.get_buffer().set_text(text or "No package details to display.")

        def finish_update_check(returncode, stdout, stderr):
            update_state["busy"] = False
            check_button.set_sensitive(True)
            flatpak_button.set_sensitive(shutil.which("flatpak") is not None)
            if returncode == 0 and stdout.strip():
                lines = [line for line in stdout.splitlines() if line.strip()]
                update_state["system_updates"] = True
                install_button.set_sensitive(True)
                update_status.set_text(f"{len(lines)} system package update(s) are available.")
                show_update_output("\n".join(lines))
            elif returncode == 2:
                update_state["system_updates"] = False
                install_button.set_sensitive(False)
                update_status.set_text("Your Darth Linux system is up to date.")
                show_update_output("No system package updates are available.")
            else:
                update_state["system_updates"] = False
                install_button.set_sensitive(False)
                detail = (stderr or stdout or "checkupdates failed without diagnostic output").strip()
                update_status.set_text("Could not check for system updates. Check your network and package mirror configuration.")
                show_update_output(detail)
            return GLib.SOURCE_REMOVE

        def check_system_updates(*_):
            if update_state["busy"]:
                return
            if not shutil.which("checkupdates"):
                update_status.set_text("The safe update checker is missing. Install pacman-contrib and try again.")
                show_update_output("Required command: checkupdates")
                install_button.set_sensitive(False)
                return
            update_state["busy"] = True
            check_button.set_sensitive(False)
            install_button.set_sensitive(False)
            update_status.set_text("Checking official repositories…")

            def worker():
                try:
                    result = subprocess.run(
                        ["checkupdates", "--nocolor"], text=True, capture_output=True,
                        timeout=300, check=False
                    )
                    GLib.idle_add(finish_update_check, result.returncode, result.stdout, result.stderr)
                except (OSError, subprocess.TimeoutExpired) as exc:
                    GLib.idle_add(finish_update_check, 1, "", str(exc))

            threading.Thread(target=worker, daemon=True).start()

        def finish_system_install(returncode, stdout, stderr):
            update_state["busy"] = False
            check_button.set_sensitive(True)
            install_button.set_sensitive(False)
            output = (stdout or "") + (("\n" + stderr) if stderr else "")
            log_dir = Path.home() / ".local/state/darth-linux"
            try:
                log_dir.mkdir(parents=True, exist_ok=True)
                (log_dir / "system-update.log").write_text(output[-200000:], encoding="utf-8")
            except OSError:
                pass
            if returncode == 0:
                update_status.set_text("System update completed. A restart is recommended to load updated system components.")
                show_update_output(output[-12000:] or "The package manager completed successfully.")
                GLib.timeout_add(1200, check_system_updates)
            else:
                update_status.set_text("System update did not complete. Review the log and resolve the package-manager message before retrying.")
                show_update_output(output[-12000:] or "No diagnostic output was returned.")
            return GLib.SOURCE_REMOVE

        def install_system_updates(*_):
            if update_state["busy"] or not update_state["system_updates"]:
                return
            if not shutil.which("pkexec"):
                update_status.set_text("Administrator authentication is unavailable (pkexec not found).")
                return
            update_state["busy"] = True
            check_button.set_sensitive(False)
            install_button.set_sensitive(False)
            flatpak_button.set_sensitive(False)
            update_status.set_text("Requesting administrator approval, then applying a complete system upgrade…")

            def worker():
                try:
                    result = subprocess.run(
                        ["pkexec", "/usr/bin/pacman", "-Syu", "--noconfirm"],
                        text=True, capture_output=True, check=False
                    )
                    GLib.idle_add(finish_system_install, result.returncode, result.stdout, result.stderr)
                except (OSError, subprocess.TimeoutExpired) as exc:
                    GLib.idle_add(finish_system_install, 1, "", str(exc))

            threading.Thread(target=worker, daemon=True).start()

        def finish_flatpak_update(returncode, stdout, stderr):
            update_state["busy"] = False
            check_button.set_sensitive(True)
            install_button.set_sensitive(update_state["system_updates"])
            flatpak_button.set_sensitive(shutil.which("flatpak") is not None)
            output = (stdout or "") + (("\n" + stderr) if stderr else "")
            if returncode == 0:
                update_status.set_text("Per-user Flatpak applications and runtimes are up to date.")
            else:
                update_status.set_text("Flatpak updates did not complete. Review the details below.")
            show_update_output(output[-12000:] or "Flatpak returned no additional details.")
            return GLib.SOURCE_REMOVE

        def update_flatpaks(*_):
            if update_state["busy"]:
                return
            if not shutil.which("flatpak"):
                update_status.set_text("Flatpak is not installed. Install it from Darth Store if you use Flatpak apps.")
                return
            update_state["busy"] = True
            check_button.set_sensitive(False)
            install_button.set_sensitive(False)
            flatpak_button.set_sensitive(False)
            update_status.set_text("Updating your per-user Flatpak apps and runtimes…")

            def worker():
                try:
                    result = subprocess.run(
                        ["flatpak", "update", "--user", "--assumeyes", "--noninteractive"],
                        text=True, capture_output=True, check=False
                    )
                    GLib.idle_add(finish_flatpak_update, result.returncode, result.stdout, result.stderr)
                except (OSError, subprocess.TimeoutExpired) as exc:
                    GLib.idle_add(finish_flatpak_update, 1, "", str(exc))

            threading.Thread(target=worker, daemon=True).start()

        update_buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        check_button = Gtk.Button(label="Check for updates")
        check_button.connect("clicked", check_system_updates)
        install_button = Gtk.Button(label="Install system updates")
        install_button.set_sensitive(False)
        install_button.connect("clicked", install_system_updates)
        flatpak_button = Gtk.Button(label="Update Flatpak apps")
        flatpak_button.set_sensitive(shutil.which("flatpak") is not None)
        flatpak_button.connect("clicked", update_flatpaks)
        update_buttons.append(check_button)
        update_buttons.append(install_button)
        update_buttons.append(flatpak_button)
        update_panel.append(update_buttons)
        update_note = Gtk.Label(
            label="System updates use checkupdates for a safe preview and pacman -Syu for the full rolling-release upgrade. "
                  "Flatpak updates are limited to apps installed for this user. Update logs: ~/.local/state/darth-linux/system-update.log"
        )
        update_note.set_xalign(0)
        update_note.set_wrap(True)
        update_note.add_css_class("dim")
        update_panel.append(update_note)

        # System and AI
        system = page("System")
        sys = section(system, "SYSTEM INFORMATION", "Quick hardware and resource diagnostics.")
        action(sys, "System summary", ["xfce4-terminal", "--command", "bash -lc 'fastfetch; echo; free -h; df -h /; exec bash'"])
        action(sys, "Task manager", ["xfce4-taskmanager"])
        action(sys, "Virtual machines", ["virt-manager"])
        ai = section(system, "LOCAL AI", "Download and run local Hugging Face GGUF models.")
        action(ai, "Open Darth AI Model Manager", ["darth-ai-manager"])
        action(ai, "Open XFCE settings manager", ["xfce4-settings-manager"])

        footer = Gtk.Label(label="Changes depend on supported hardware and installed services. This panel does not bypass device permissions or firmware limits.")
        footer.set_wrap(True); footer.set_xalign(0); footer.add_css_class("dim")
        outer.append(footer)
        win.present()

    def do_launch(self, args):
        try:
            subprocess.Popen(args)
        except OSError as exc:
            dialog = Gtk.AlertDialog()
            dialog.set_message("Could not launch this control")
            dialog.set_detail(str(exc))
            dialog.show(self.get_active_window())

app = DarthSettings()
app.run(None)
