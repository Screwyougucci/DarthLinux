#!/usr/bin/env python3
"""Darth Watchtower: lightweight local system and security dashboard."""
import csv, os, shutil, subprocess, time, threading
from pathlib import Path
import gi
gi.require_version("Gtk","4.0")
from gi.repository import Gtk, GLib, Gio, Gdk

THEMES={
 "Darth Red":("#111014","#ed3448","#24202a"),
 "Cyberpunk":("#101020","#55e8ff","#29213b"),
 "Matrix":("#07130b","#48e879","#102719"),
 "Ghost":("#101820","#8ccfff","#202d38"),
 "Command":("#111318","#e5e7eb","#252a33")}
def read_cpu():
 try:
  v=list(map(int,Path("/proc/stat").read_text().splitlines()[0].split()[1:]))
  if len(v)<8:return None
  return sum(v[:8]),v[3]+v[4]
 except (OSError,ValueError,IndexError):return None
def metrics():
 mem={}
 try:
  for l in Path("/proc/meminfo").read_text().splitlines():
   k,v=l.split(":",1);mem[k]=int(v.split()[0])
 except Exception:pass
 total=mem.get("MemTotal",0);avail=mem.get("MemAvailable",0)
 du=shutil.disk_usage("/")
 cpu="unavailable"
 try:
  first=read_cpu()
  if first is not None:
   time.sleep(.08)
   second=read_cpu()
   if second is not None:
    a,b=first;c,d=second
    cpu=f"{max(0.0,min(100.0,100*(1-(d-b)/max(1,c-a)))):.1f}%"
 except Exception:pass
 rx=tx=0
 try:
  for line in Path("/proc/net/dev").read_text().splitlines()[2:]:
   name,vals=line.split(":");v=list(map(int,vals.split()))
   if name.strip()!="lo":rx+=v[0];tx+=v[8]
 except Exception:pass
 return {"CPU":cpu,"Memory":f"{(total-avail)/1024:.0f} / {total/1024:.0f} MiB","Disk":f"{du.used/du.total*100:.1f}% used ({du.free//(1024**3)} GiB free)","Network":f"RX {rx/1048576:.1f} MiB total · TX {tx/1048576:.1f} MiB total","Firewall service":cmd(["systemctl","is-active","nftables"]),"Darth firewall rules":firewall_rules_status(),"ClamAV daemon":cmd(["systemctl","is-active","clamav-daemon"]),"Kernel":cmd(["uname","-r"])}
def cmd(args):
 try:
  p=subprocess.run(args,text=True,capture_output=True,timeout=2);return (p.stdout or p.stderr).strip() or "not reported"
 except Exception:return "unavailable"
def firewall_rules_status():
 try:
  p=subprocess.run(["nft","list","table","inet","darth_filter"],text=True,capture_output=True,timeout=2)
  if p.returncode == 0:
   return "loaded"
  error=(p.stderr or p.stdout).lower()
  if "operation not permitted" in error or "permission denied" in error:
   return "unknown (administrator permission required)"
  if "no such file or directory" in error or "does not exist" in error:
   return "not loaded"
  return "unknown (nft query failed)"
 except (OSError,subprocess.TimeoutExpired):return "unavailable"
class App(Gtk.Application):
 def __init__(self):super().__init__(application_id="org.darthlinux.Watchtower",flags=Gio.ApplicationFlags.DEFAULT_FLAGS);self.values={};self.refreshing=False;self.css_provider=None
 def do_activate(self):
  w=Gtk.ApplicationWindow(application=self);w.set_title("DARTH // WATCHTOWER");w.set_default_size(900,650);self.win=w
  root=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=12);root.set_margin_top(20);root.set_margin_bottom(20);root.set_margin_start(22);root.set_margin_end(22);w.set_child(root)
  top=Gtk.Box(spacing=10);root.append(top)
  title=Gtk.Label(label="DARTH WATCHTOWER  //  SYSTEM INTELLIGENCE");title.set_xalign(0);title.set_hexpand(True);title.add_css_class("title-1");top.append(title)
  self.theme=Gtk.DropDown.new_from_strings(list(THEMES));top.append(self.theme);self.theme.connect("notify::selected",lambda *_:self.style())
  self.grid=Gtk.Grid(column_spacing=12,row_spacing=12);self.grid.set_hexpand(True);self.grid.set_vexpand(True);root.append(self.grid)
  self.labels={}
  for i,k in enumerate(["CPU","Memory","Disk","Network","Firewall service","Darth firewall rules","ClamAV daemon","Kernel"]):
   frame=Gtk.Frame(label=k);box=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=8);box.set_margin_top(14);box.set_margin_bottom(14);box.set_margin_start(14);box.set_margin_end(14)
   val=Gtk.Label(label="Collecting…");val.set_wrap(True);val.set_xalign(0);box.append(val);frame.set_child(box);self.grid.attach(frame,i%2,i//2,1,1);self.labels[k]=val
  actions=Gtk.Box(spacing=8);root.append(actions)
  b=Gtk.Button(label="Refresh now");b.connect("clicked",lambda *_:self.refresh());actions.append(b)
  b=Gtk.Button(label="Export CSV report");b.connect("clicked",lambda *_:self.export());actions.append(b)
  note=Gtk.Label(label="Local-only telemetry · values are read from this machine · no data is uploaded");note.set_xalign(0);root.append(note)
  self.style();self.refresh();GLib.timeout_add_seconds(3,self.refresh);w.present()
 def style(self):
  bg,accent,panel=list(THEMES.values())[self.theme.get_selected()]
  display=Gdk.Display.get_default()
  if not display:return
  if self.css_provider is not None:Gtk.StyleContext.remove_provider_for_display(display,self.css_provider)
  self.css_provider=Gtk.CssProvider();self.css_provider.load_from_data(f"window {{background:{bg};color:#eee}} label {{color:#eee}} .title-1 {{color:{accent};font-weight:800}} frame {{background:{panel};border:1px solid {accent};border-radius:10px;padding:8px}} button {{padding:8px}}".encode())
  Gtk.StyleContext.add_provider_for_display(display,self.css_provider,Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
 def refresh(self):
  if self.refreshing:return True
  self.refreshing=True
  def collect():
   try:
    values=metrics()
   except Exception as exc:
    values={key:"unavailable" for key in self.labels}
    values["Disk"]="unavailable ("+str(exc)+")"
   GLib.idle_add(self.apply_refresh,values)
  threading.Thread(target=collect,daemon=True).start()
  return True
 def apply_refresh(self,values):
  self.values=values
  for k,v in values.items():self.labels[k].set_text(v)
  self.refreshing=False
  return False
 def show_message(self,title,detail):
  dialog=Gtk.AlertDialog()
  dialog.set_message(title)
  dialog.set_detail(detail)
  dialog.show(self.win)
 def export(self):
  if not self.values:
   self.show_message("No metrics available","Wait for the first dashboard refresh, then export the report.")
   return
  path=Path.home()/("darth-watchtower-"+time.strftime("%Y%m%d-%H%M%S")+".csv")
  try:
   fd=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
   with os.fdopen(fd,"w",newline="") as f:
    wr=csv.writer(f)
    wr.writerow(["metric","value","captured_local"])
    captured=time.strftime("%Y-%m-%d %H:%M:%S")
    for key,value in self.values.items():
     wr.writerow([key,value,captured])
  except OSError as exc:
   self.show_message("Report export failed",str(exc))
   return
  self.show_message("Report exported",f"{path}\nSaved with owner-only permissions. Review before sharing: reports may reveal host and security state.")
App().run(None)
