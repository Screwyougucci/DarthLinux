#!/usr/bin/env python3
"""Darth Center: lightweight, read-only terminal status dashboard."""
import os, shutil, subprocess, time
from pathlib import Path

def command(args):
    try:
        p=subprocess.run(args,text=True,capture_output=True,timeout=3,check=False)
        return (p.stdout or p.stderr).strip()
    except (OSError,subprocess.TimeoutExpired): return "unavailable"

def memory():
    try:
        data={}
        for line in Path("/proc/meminfo").read_text().splitlines():
            k,v=line.split(":",1); data[k]=int(v.strip().split()[0])
        total=data.get("MemTotal",0); avail=data.get("MemAvailable",0)
        if total <= 0:return "unavailable"
        return f"{(total-avail)/1024:.0f} MiB used / {total/1024:.0f} MiB total"
    except Exception: return "unavailable"

def cpu():
    try:
        def sample():
            vals=list(map(int,Path("/proc/stat").read_text().splitlines()[0].split()[1:]))
            return sum(vals[:8]), vals[3]+(vals[4] if len(vals)>4 else 0)
        t1,i1=sample(); time.sleep(.2); t2,i2=sample()
        usage=100*(1-(i2-i1)/max(1,t2-t1))
        return f"{max(0.0,min(100.0,usage)):.1f}%"
    except Exception: return "unavailable"

def firewall_rules_status():
    try:
        p=subprocess.run(["nft","list","table","inet","darth_filter"],text=True,capture_output=True,timeout=3,check=False)
        if p.returncode==0:return "loaded"
        if "Operation not permitted" in p.stderr:return "unknown (permission required)"
        return "not loaded"
    except (OSError,subprocess.TimeoutExpired):return "unavailable"

def clam_db_time():
    db=Path("/var/lib/clamav")
    stamps=[p.stat().st_mtime for p in db.iterdir() if p.is_file() and p.suffix in (".cvd",".cld")] if db.exists() else []
    return time.strftime("%Y-%m-%d %H:%M",time.localtime(max(stamps))) if stamps else "not initialized"

def main():
    while True:
        os.system("clear")
        disk=shutil.disk_usage("/")
        print("\033[91m╔══════════════════════════════════════════════════════╗")
        print("║                 DARTH LINUX // CENTER               ║")
        print("╚══════════════════════════════════════════════════════╝\033[0m")
        print(f" Host: {command(['hostname'])}    Kernel: {command(['uname','-r'])}")
        print(f" CPU activity: {cpu()}    Memory: {memory()}")
        print(f" Root disk: {disk.used//(1024**3)} GiB used / {disk.total//(1024**3)} GiB")
        print("\n--- DEFENSE STATUS ---")
        print(f" Firewall service (nftables): {command(['systemctl','is-active','nftables'])}")
        print(f" Darth firewall rules:   {firewall_rules_status()}")
        print(f" ClamAV daemon:       {command(['systemctl','is-active','clamav-daemon'])}")
        print(f" Signature updater:   {command(['systemctl','is-active','clamav-freshclam'])}")
        print(f" AV definitions:      {clam_db_time()}")
        print(f" Rootkit checker:     {'installed' if shutil.which('rkhunter') else 'not installed'}")
        print("\nRefresh: 3 seconds | Press Ctrl+C to exit")
        time.sleep(3)

if __name__=="__main__":
    try: main()
    except KeyboardInterrupt: print("\nDarth Center closed.")
