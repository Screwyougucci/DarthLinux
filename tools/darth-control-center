#!/usr/bin/env python3
"""Darth Control Center: lightweight GTK4 launcher and status panel."""
import subprocess
import threading
import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, Gio, Gdk, GLib

def run(args):
    try:
        p = subprocess.run(args, text=True, capture_output=True, timeout=3, check=False)
        return (p.stdout or p.stderr).strip() or "No details reported"
    except (OSError, subprocess.TimeoutExpired) as exc:
        return str(exc)

def firewall_rules_status():
    try:
        p = subprocess.run(["nft", "list", "table", "inet", "darth_filter"],
                           text=True, capture_output=True, timeout=3, check=False)
        if p.returncode == 0:
            return "Darth ruleset loaded"
        error = (p.stderr or p.stdout).lower()
        if "operation not permitted" in error or "permission denied" in error:
            return "Unknown (administrator permission required)"
        if "no such file or directory" in error or "does not exist" in error:
            return "Darth ruleset not loaded"
        return "Unknown (nft query failed)"
    except (OSError, subprocess.TimeoutExpired):
        return "Unknown (nft unavailable)"

class ControlCenter(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.darthlinux.ControlCenter",
                         flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        css = Gtk.CssProvider()
        css.load_from_data(b"""
            window.darth-window { background: #101116; color: #eeeeF4; }
            .darth-window label { color: #eeeeF4; }
            .darth-window .title-1 { color: #f04452; font-weight: 800; }
            .darth-window button {
                background: #20232c; color: #f4f4f6;
                border: 1px solid #7e2631; border-radius: 10px;
                padding: 12px;
            }
            .darth-window button:hover { background: #38212a; border-color: #ff4655; }
            .darth-window .card {
                background: #191c24; border: 1px solid #44404a;
                border-radius: 10px; padding: 16px;
            }
            .darth-window .dim-label { color: #a9a9b4; }
        """)
        display = Gdk.Display.get_default()
        if display:
            Gtk.StyleContext.add_provider_for_display(
                display, css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        win = Gtk.ApplicationWindow(application=self)
        win.add_css_class("darth-window")
        win.set_title("Darth Linux // Control Center")
        win.set_default_size(760, 600)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        root.set_margin_top(22); root.set_margin_bottom(22)
        root.set_margin_start(24); root.set_margin_end(24)
        win.set_child(root)

        title = Gtk.Label(label="DARTH LINUX  //  CONTROL CENTER")
        title.add_css_class("title-1")
        title.set_halign(Gtk.Align.START)
        root.append(title)
        subtitle = Gtk.Label(label="SYSTEM  •  VIRTUALIZATION  •  NETWORK  •  DEFENSE")
        subtitle.add_css_class("dim-label")
        subtitle.set_halign(Gtk.Align.START)
        root.append(subtitle)

        status = Gtk.Label()
        status.set_xalign(0)
        status.set_selectable(True)
        status.add_css_class("card")
        root.append(status)

        refresh_state = {"busy": False}

        def apply_refresh(message):
            status.set_text(message)
            refresh_state["busy"] = False
            return GLib.SOURCE_REMOVE

        def refresh(*_):
            if refresh_state["busy"]:
                return
            refresh_state["busy"] = True
            status.set_text("Refreshing network and firewall status…")

            def worker():
                active = run(["nmcli", "-t", "-f", "NAME,TYPE,DEVICE", "connection", "show", "--active"])
                vpn_lines = [line for line in active.splitlines() if "vpn" in line.lower() or "wireguard" in line.lower()]
                vpn = "\n".join(vpn_lines) if vpn_lines else "No VPN connection currently active"
                firewall = run(["systemctl", "is-active", "nftables"])
                rules = firewall_rules_status()
                message = ("NETWORK / VPN STATUS\n" + vpn + "\n\nFirewall service (nftables): "
                           + firewall + "\nDarth firewall rules: " + rules)
                GLib.idle_add(apply_refresh, message)

            threading.Thread(target=worker, daemon=True).start()

        refresh()

        grid = Gtk.Grid(column_spacing=10, row_spacing=10)
        scroller = Gtk.ScrolledWindow()
        scroller.set_vexpand(True)
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroller.set_child(grid)
        root.append(scroller)

        def launch(label, command, description, col, row):
            button = Gtk.Button()
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
            name = Gtk.Label(label=label); name.add_css_class("heading")
            detail = Gtk.Label(label=description); detail.add_css_class("dim-label")
            box.append(name); box.append(detail)
            button.set_child(box)
            button.set_hexpand(True); button.set_vexpand(True)
            button.set_size_request(220, 78)
            button.connect("clicked", lambda *_: self.open_app(command))
            grid.attach(button, col, row, 1, 1)

        launch("Virtual Machines", ["virt-manager"], "Create and manage QEMU/KVM guests", 0, 0)
        launch("VPN Connections", ["nm-connection-editor"], "Import and manage OpenVPN / WireGuard", 1, 0)
        launch("Network Monitor", ["xfce4-terminal", "--command", "btop"], "CPU, memory, processes and network", 0, 1)
        launch("Network Diagnostics", ["xfce4-terminal", "--command", "bash -lc 'ip -brief address; echo; ip route; exec bash'"], "Inspect local interfaces and routes", 1, 1)
        launch("Darth Notes", ["darth-notes"], "Lightweight Notepad-style plain-text editor", 0, 2)
        launch("Antivirus", ["clamui"], "Open the ClamAV graphical scanner", 1, 2)
        launch("Security Dashboard", ["xfce4-terminal", "--command", "darth-center"], "Firewall, system and AV status", 0, 3)
        launch("Authorized Scope Scan", ["xfce4-terminal", "--hold", "--command", "darth-scope-scan"], "Private lab range only; asks for scope", 1, 3)
        launch("Residential Proxy", ["darth-proxy"], "Configure and test your provider proxy in Firefox", 0, 4)
        launch("AI Model Manager", ["darth-ai-manager"], "Download Hugging Face GGUF models and run locally", 1, 4)
        launch("System Settings", ["darth-settings"], "Audio, display, webcam, video, network and security", 0, 5)
        launch("Watchtower", ["darth-watchtower"], "Live CPU, memory, disk, network and defense status", 1, 5)
        launch("Driver Manager", ["darth-driver-manager"], "Hardware inventory and driver diagnostics", 0, 6)
        launch("Darth Store", ["darth-store"], "Search and install from trusted pacman repositories", 1, 6)
        launch("Guardian Firewall", ["xfce4-terminal", "--hold", "--command", "darth-guardian status"], "Inspect and manage nftables", 0, 7)
        launch("Sentinel Antivirus", ["xfce4-terminal", "--hold", "--command", "darth-sentinel"], "On-demand scanning and quarantine", 1, 7)
        launch("Recovery", ["xfce4-terminal", "--hold", "--command", "darth-recovery"], "Backup and restore user-selected data", 0, 8)
        launch("Privacy", ["xfce4-terminal", "--command", "darth-privacy"], "Review local services and listening sockets", 1, 8)
        launch("Lockdown", ["darth-lockdown"], "Lock the current desktop session", 0, 9)
        launch("Red Lab", ["xfce4-terminal", "--hold", "--command", "darth-redlab"], "Authorized security lab tool status", 1, 9)

        refresh_button = Gtk.Button(label="Refresh VPN / firewall status")
        refresh_button.connect("clicked", refresh)
        root.append(refresh_button)

        note = Gtk.Label(label="VPN providers are not included. Import a configuration from a VPN provider you trust. A connected VPN is not a complete anonymity or security guarantee.")
        note.set_wrap(True); note.set_xalign(0); note.add_css_class("dim-label")
        root.append(note)
        win.present()

    def open_app(self, command):
        try:
            subprocess.Popen(command)
        except OSError as exc:
            dialog = Gtk.AlertDialog()
            dialog.set_message("Could not launch application")
            dialog.set_detail(str(exc))
            dialog.show(self.get_active_window())

app = ControlCenter()
app.run(None)
