#!/usr/bin/env bash
set -Eeuo pipefail
if [[ $# -gt 1 ]]; then echo "Usage: darth-av-scan [path/to/scan]" >&2; exit 2; fi
if [[ $# -eq 0 ]]; then
  [[ -t 0 ]] || { echo "Usage: darth-av-scan /path/to/scan" >&2; exit 2; }
  read -r -p "File or folder to scan: " TARGET
else
  TARGET="$1"
fi
[[ -n "$TARGET" ]] || { echo "No scan target supplied." >&2; exit 2; }
command -v clamscan >/dev/null 2>&1 || { echo "ClamAV is not installed." >&2; exit 1; }
TARGET="$(realpath -- "$TARGET")"
[[ -e "$TARGET" ]] || { echo "Target does not exist: $TARGET" >&2; exit 1; }
echo "Checking ClamAV signature updater..."
latest_db=0
for db in /var/lib/clamav/*.cvd /var/lib/clamav/*.cld; do
  [[ -f "$db" ]] || continue
  db_mtime="$(stat -c %Y -- "$db" 2>/dev/null || echo 0)"
  (( db_mtime > latest_db )) && latest_db="$db_mtime"
done
now="$(date +%s)"
UPDATE_STAMP="$HOME/.cache/darth-linux/clamav-last-update-attempt"
last_attempt=0
[[ -f "$UPDATE_STAMP" ]] && read -r last_attempt < "$UPDATE_STAMP" || true
if (( latest_db > 0 && now - latest_db < 3600 )); then
  echo "Signature database was updated within the last hour; skipping another CDN check."
elif systemctl is-active --quiet clamav-freshclam.service || systemctl is-active --quiet clamav-freshclam-once.timer; then
  echo "Automatic ClamAV updater is enabled; leaving database updates to systemd."
elif (( last_attempt > 0 && now - last_attempt < 3600 )); then
  echo "A signature update was attempted within the last hour; skipping another CDN check."
elif [[ $EUID -eq 0 ]]; then
  mkdir -p "$(dirname "$UPDATE_STAMP")"
  printf '%s\n' "$now" > "$UPDATE_STAMP"
  freshclam || echo "Warning: signature update failed; using the installed database." >&2
elif command -v sudo >/dev/null 2>&1; then
  echo "Administrator permission is needed to update the system-wide signature database."
  mkdir -p "$(dirname "$UPDATE_STAMP")"
  printf '%s\n' "$now" > "$UPDATE_STAMP"
  sudo freshclam || echo "Warning: signature update failed or was declined; using the installed database." >&2
else
  echo "Warning: cannot update system-wide signatures without administrator permission; using the installed database." >&2
fi
echo "Scanning: $TARGET"
echo "No files will be automatically deleted or quarantined."
set +e
clamscan --infected --recursive --log="$HOME/darth-clamav-scan.log" -- "$TARGET"
status=$?
set -e
if [[ $status -eq 0 ]]; then
  echo "Scan complete: no detections."
elif [[ $status -eq 1 ]]; then
  echo "Scan complete: detections found. Review $HOME/darth-clamav-scan.log; do not open flagged files."
else
  echo "ClamAV scan failed (exit $status). Check the log and signature database." >&2
fi
exit "$status"
