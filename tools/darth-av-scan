#!/usr/bin/env bash
set -Eeuo pipefail
if [[ $# -gt 1 ]]; then echo "Usage: darth-av-scan [path/to/scan]" >&2; exit 2; fi
if [[ $# -eq 0 ]]; then
  [[ -t 0 ]] || { echo "Usage: darth-av-scan /path/to/scan" >&2; exit 2; }
  read -r -p "File or folder to scan: " TARGET
else
  TARGET="$1"
fi
[[ -n "$TARGET" ]] || { echo "No scan target supplied." >&2; exit 2; }
command -v clamscan >/dev/null 2>&1 || { echo "ClamAV is not installed." >&2; exit 1; }
TARGET="$(realpath -- "$TARGET")"
[[ -e "$TARGET" ]] || { echo "Target does not exist: $TARGET" >&2; exit 1; }
echo "Updating ClamAV signatures (if configured)..."
freshclam || echo "Warning: signature update failed; using the installed database." >&2
echo "Scanning: $TARGET"
echo "No files will be automatically deleted or quarantined."
set +e
clamscan --infected --recursive --log="$HOME/darth-clamav-scan.log" -- "$TARGET"
status=$?
set -e
if [[ $status -eq 0 ]]; then
  echo "Scan complete: no detections."
elif [[ $status -eq 1 ]]; then
  echo "Scan complete: detections found. Review $HOME/darth-clamav-scan.log; do not open flagged files."
else
  echo "ClamAV scan failed (exit $status). Check the log and signature database." >&2
fi
exit "$status"
