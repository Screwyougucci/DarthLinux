            row.append(button)
            self.results.append(row)

    def run_async(self, args, success_message):
        if self.busy:
            self.set_status("Another package operation is already running. Please wait.")
            return
        self.busy = True
        self.set_status("Working… package operations can take a few minutes.")

        def worker():
            try:
                result = subprocess.run(args, text=True, capture_output=True,
                                        timeout=1800, check=False)
                output = (result.stdout or "") + (result.stderr or "")
                if result.returncode == 0:
                    message = success_message + ("\n" + output[-12000:] if output.strip() else "")
                else:
                    message = f"Command failed (exit {result.returncode}).\n{output[-12000:]}"
            except subprocess.TimeoutExpired:
                message = "Package operation timed out after 30 minutes."
            except OSError as exc:
                message = f"Could not start package manager: {exc}"
            GLib.idle_add(self.finish_operation, message)

        threading.Thread(target=worker, daemon=True).start()

    def finish_operation(self, message):
        self.busy = False
        self.set_status(message)
        return False

    def search(self, *_):
        query = self.entry.get_text().strip()
        if not query or not SEARCH_RE.fullmatch(query):
            self.set_status("Enter a search term using letters, numbers, spaces or . _ + : - (80 characters max).")
            return
        if self.busy:
            self.set_status("Wait for the current package operation to finish.")
            return
        self.busy = True
        self.set_status("Searching all official package repositories…")

        def worker():
            try:
                # Search names and descriptions, exposing only official repositories.
                result = subprocess.run(["pacman", "-Ss", re.escape(query)], text=True,
                                        capture_output=True, timeout=120, check=False)
                if result.returncode not in (0, 1):
                    error = "Official repository search failed.\n" + (result.stderr or result.stdout)[-8000:]
                    matches = []
                else:
                    matches = []
                    lines = result.stdout.splitlines()
                    index = 0
                    while index < len(lines):
                        header = lines[index].strip()
                        match = re.match(r"^([A-Za-z0-9_-]+)/([A-Za-z0-9@._+:-]+)\s+([^\s]+)(?:\s+\[installed\])?$", header)
                        if match and match.group(1) in OFFICIAL_REPOSITORIES:
                            description = lines[index + 1].strip() if index + 1 < len(lines) else ""
                            matches.append((match.group(1), match.group(2), match.group(3), description))
                        index += 1
                    error = ""
                GLib.idle_add(self.display_search_results, query, matches[:150], error)
            except (OSError, subprocess.TimeoutExpired) as exc:
                GLib.idle_add(self.display_search_results, query, [], "Repository search unavailable: " + str(exc))

        threading.Thread(target=worker, daemon=True).start()

    def display_search_results(self, query, matches, error):
        self.busy = False
        self.clear_results()
        heading = Gtk.Label(label=f"DARTH APP SEARCH  //  {query}")
        heading.set_xalign(0)
        heading.add_css_class("heading")
        self.results.append(heading)
        back = Gtk.Button(label="Back to app catalog")
        back.set_halign(Gtk.Align.START)
        back.connect("clicked", lambda *_: self.show_catalog())
        self.results.append(back)
        if error:
            self.set_status(error)
        elif not matches:
            self.set_status("No matches found in the official repositories. Try a shorter or different search term.")
        else:
            self.set_status(f"{len(matches)} matching app/package(s) shown (up to 150). Select Install to review dependencies.")
            for repository, package, version, description in matches:
                row = Gtk.Box(spacing=10)
                details = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                details.set_hexpand(True)
                name = Gtk.Label(label=package)
                name.set_xalign(0)
                name.add_css_class("heading")
                details.append(name)
                summary = Gtk.Label(label=f"{repository} · {version}" + (f" · {description}" if description else ""))
                summary.set_xalign(0)
                summary.set_wrap(True)
                summary.add_css_class("dim-label")
                details.append(summary)
                row.append(details)
                install = Gtk.Button(label="Install…")
                install.connect("clicked", lambda _b, r=repository, p=package: self.confirm_install(r + "/" + p, p))
                row.append(install)
