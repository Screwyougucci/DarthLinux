                    lines = result.stdout.splitlines()
                    index = 0
                    while index < len(lines):
                        header = lines[index].strip()
                        match = re.match(r"^([A-Za-z0-9_-]+)/([A-Za-z0-9@._+:-]+)\\s+([^\\s]+)(?:\\s+\\[installed\\])?$", header)
                        if match and match.group(1) in OFFICIAL_REPOSITORIES:
                            description = lines[index + 1].strip() if index + 1 < len(lines) else ""
                            matches.append((match.group(1), match.group(2), match.group(3), description))
                        index += 1
                    error = ""
                GLib.idle_add(self.display_search_results, query, matches[:150], error)
            except (OSError, subprocess.TimeoutExpired) as exc:
                GLib.idle_add(self.display_search_results, query, [], "Repository search unavailable: " + str(exc))

        threading.Thread(target=worker, daemon=True).start()

    def display_search_results(self, query, matches, error):
        self.busy = False
        self.clear_results()
        heading = Gtk.Label(label=f"DARTH APP SEARCH  //  {query}")
        heading.set_xalign(0)
        heading.add_css_class("heading")
        self.results.append(heading)
        back = Gtk.Button(label="Back to app catalog")
        back.set_halign(Gtk.Align.START)
        back.connect("clicked", lambda *_: self.show_catalog())
        self.results.append(back)
        if error:
            self.set_status(error)
        elif not matches:
            self.set_status("No matches found in the official repositories. Try a shorter or different search term.")
        else:
            self.set_status(f"{len(matches)} matching package(s) shown. Select Install to review the package transaction.")
            for package, version in matches:
                row = Gtk.Box(spacing=10)
                details = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                details.set_hexpand(True)
                name = Gtk.Label(label=package)
                name.set_xalign(0)
                name.add_css_class("heading")
                details.append(name)
                version_label = Gtk.Label(label=f"Extra repository · {version}")
                version_label.set_xalign(0)
                version_label.add_css_class("dim-label")
                details.append(version_label)
                row.append(details)
                install = Gtk.Button(label="Install…")
                install.connect("clicked", lambda _b, p=package: self.confirm_install(p, p))
                row.append(install)
                self.results.append(row)
        return False

    def installed(self, *_):
        self.run_async(["pacman", "-Q"], "Installed packages")

    def enable_flathub(self, *_):
        if self.busy:
            self.set_status("Wait for the current package operation to finish.")
            return
        self.busy = True
        self.set_status("Setting up optional Flathub support…")

        def worker():
            try:
                if not shutil_which("flatpak"):
                    install = subprocess.run(
                        ["pkexec", "pacman", "-S", "--needed", "--", "extra/flatpak"],
                        text=True, capture_output=True, timeout=1800, check=False
                    )
                    if install.returncode != 0:
                        raise RuntimeError((install.stderr or install.stdout or "Flatpak installation was cancelled.")[-8000:])
                add = subprocess.run(
                    ["flatpak", "remote-add", "--user", "--if-not-exists", "flathub",
                     "https://dl.flathub.org/repo/flathub.flatpakrepo"],
                    text=True, capture_output=True, timeout=180, check=False
                )
                if add.returncode != 0:
                    raise RuntimeError((add.stderr or add.stdout or "Could not add Flathub.")[-8000:])
                message = "Flathub is enabled for this user. Apps are downloaded only when you choose to install them."
            except (OSError, subprocess.TimeoutExpired, RuntimeError) as exc:
                message = "Flathub setup failed: " + str(exc)
            GLib.idle_add(self.finish_operation, message)

        threading.Thread(target=worker, daemon=True).start()

    def confirm_flatpak(self, name, app_id):
        if self.busy:
            self.set_status("Wait for the current package operation to finish.")
            return
        if not shutil_which("flatpak"):
            self.set_status("Select Enable Flathub first. Flatpak is optional and is not preinstalled.")
            return
        dialog = Gtk.MessageDialog(
            transient_for=self.win, modal=True, message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.YES_NO, text=f"Install {name} from Flathub?"
        )
        dialog.set_secondary_text(
            f"Application ID: {app_id}\nInstalls into your user account using Flatpak's sandboxed app format. "
            "The first install may download a shared runtime."
        )

        def answer(dlg, response):
            dlg.destroy()
            if response != Gtk.ResponseType.YES:
                return
            if self.busy:
                self.set_status("Another package operation is already running.")
                return
            self.busy = True
            self.set_status(f"Downloading {name} from Flathub…")

            def worker():
                try:
                    remotes = subprocess.run(["flatpak", "remotes", "--user", "--columns=name"],
                                             text=True, capture_output=True, timeout=30, check=False)
                    if remotes.returncode != 0 or "flathub" not in remotes.stdout.split():
                        raise RuntimeError("Flathub is not enabled. Select Enable Flathub first.")
                    result = subprocess.run(
                        ["flatpak", "install", "--user", "--noninteractive", "flathub", app_id],
                        text=True, capture_output=True, timeout=1800, check=False
                    )
                    output = (result.stdout or "") + (result.stderr or "")
                    message = (f"Installed {name}." if result.returncode == 0 else
                               f"Flatpak install failed (exit {result.returncode}).\n{output[-10000:]}")
                except (OSError, subprocess.TimeoutExpired, RuntimeError) as exc:
                    message = "Flatpak install failed: " + str(exc)
                GLib.idle_add(self.finish_operation, message)

            threading.Thread(target=worker, daemon=True).start()

        dialog.connect("response", answer)
        dialog.present()

    def confirm_install(self, package, display_name=None):
        if self.busy:
            self.set_status("Wait for the current package operation to finish.")
            return
        dialog = Gtk.MessageDialog(
            transient_for=self.win, modal=True, message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.YES_NO,
            text=f"Install {display_name or package}?"
        )
        dialog.set_secondary_text(
            f"Package: {package}\n\nThe system package manager will show the complete "
            "transaction and dependencies. Review them before approving authentication."
        )

        def answer(dlg, response):
            dlg.destroy()
            if response == Gtk.ResponseType.YES:
                if not shutil_which("pkexec"):
                    self.set_status("pkexec is missing. Install the polkit package to enable authenticated installs.")
                    return
                self.run_async(
                    ["pkexec", "pacman", "-S", "--needed", "--", package],
                    f"Installation finished for {package}."
                )

        dialog.connect("response", answer)
        dialog.present()


def shutil_which(name):
    import shutil
    return shutil.which(name)


Store().run(None)
