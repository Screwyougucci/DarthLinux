#!/usr/bin/env bash
set -Eeuo pipefail
command -v xfce4-terminal >/dev/null 2>&1 || {
  printf 'Darth Installer requires xfce4-terminal.\n' >&2
  exit 127
}
command -v darth-installer-session >/dev/null 2>&1 || {
  printf 'Darth Installer session is missing.\n' >&2
  exit 127
}
exec xfce4-terminal --icon=darth-linux --title="DARTH // INSTALLER" --hold --command="darth-installer-session"
