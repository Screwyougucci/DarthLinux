#!/usr/bin/env python3
"""Darth Recovery: user-selected backup and cautious restore."""
import argparse
import sys
import tarfile
from pathlib import Path

parser = argparse.ArgumentParser(
    description="Create or restore a tar backup. Restore extracts only into a new empty directory."
)
sub = parser.add_subparsers(dest="cmd")
backup = sub.add_parser("backup")
backup.add_argument("source")
backup.add_argument("archive")
restore = sub.add_parser("restore")
restore.add_argument("archive")
restore.add_argument("destination")
args = parser.parse_args()
if args.cmd is None:
    if not sys.stdin.isatty():
        parser.print_help()
        sys.exit(2)
    choice = input("Choose backup or restore [backup/restore]: ").strip().lower()
    if choice == "backup":
        args.cmd = "backup"
        args.source = input("Source file or folder: ").strip()
        args.archive = input("Destination .tar.gz archive: ").strip()
    elif choice == "restore":
        args.cmd = "restore"
        args.archive = input("Backup .tar.gz archive: ").strip()
        args.destination = input("New or empty restore directory: ").strip()
    else:
        sys.exit("Choose backup or restore.")

if args.cmd == "backup":
    source = Path(args.source).expanduser().resolve()
    archive = Path(args.archive).expanduser().resolve()
    if not source.exists():
        sys.exit("Source does not exist.")
    if archive.exists():
        sys.exit("Archive already exists; choose a new path to avoid overwriting existing data.")
    if archive == source or (source.is_dir() and source in archive.parents):
        sys.exit("Archive must be outside the source; refusing to overwrite or back up itself.")
    archive.parent.mkdir(parents=True, exist_ok=True)
    try:
        with tarfile.open(archive, "w:gz") as stream:
            stream.add(source, arcname=source.name, recursive=True)
    except (OSError, tarfile.TarError) as exc:
        sys.exit(f"Backup failed: {exc}")
    print(f"Backup created: {archive}")
else:
    archive = Path(args.archive).expanduser().resolve()
    destination = Path(args.destination).expanduser().resolve()
    if not archive.is_file():
        sys.exit("Archive not found.")
    if destination.exists() and (not destination.is_dir() or any(destination.iterdir())):
        sys.exit("Restore destination must be a new or empty directory.")
    if input(f"Type RESTORE to extract {archive} into {destination}: ").strip() != "RESTORE":
        sys.exit("Cancelled.")
    destination.mkdir(parents=True, exist_ok=True)
    try:
        with tarfile.open(archive, "r:gz") as stream:
            root = destination.resolve()
            for member in stream.getmembers():
                target = (destination / member.name).resolve()
                if target != root and root not in target.parents:
                    sys.exit("Unsafe archive path rejected.")
            stream.extractall(destination, filter="data")
    except (OSError, tarfile.TarError) as exc:
        sys.exit(f"Restore failed: {exc}")
    print(f"Restore extracted to: {destination}")
