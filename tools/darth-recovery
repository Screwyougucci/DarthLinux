#!/usr/bin/env python3
"""Darth Recovery: user-selected backup and cautious restore."""
import argparse,tarfile,sys
from pathlib import Path
p=argparse.ArgumentParser(description="Create or restore a tar backup. Restore extracts only into a new empty directory.")
sub=p.add_subparsers(dest="cmd",required=True)
b=sub.add_parser("backup");b.add_argument("source");b.add_argument("archive")
r=sub.add_parser("restore");r.add_argument("archive");r.add_argument("destination")
a=p.parse_args()
if a.cmd=="backup":
 src=Path(a.source).expanduser().resolve();out=Path(a.archive).expanduser()
 if not src.exists():sys.exit("Source does not exist.")
 with tarfile.open(out,"w:gz") as t:t.add(src,arcname=src.name,recursive=True)
 print(f"Backup created: {out}")
else:
 arc=Path(a.archive).expanduser().resolve();dest=Path(a.destination).expanduser().resolve()
 if not arc.is_file():sys.exit("Archive not found.")
 if dest.exists() and any(dest.iterdir()):sys.exit("Restore destination must be new or empty.")
 if input(f"Type RESTORE to extract {arc} into {dest}: ").strip()!="RESTORE":sys.exit("Cancelled.")
 dest.mkdir(parents=True,exist_ok=True)
 with tarfile.open(arc,"r:gz") as t:
  root=dest.resolve()
  for member in t.getmembers():
   target=(dest/member.name).resolve()
   if target!=root and root not in target.parents:sys.exit("Unsafe archive path rejected.")
  t.extractall(dest,filter="data")
 print(f"Restore extracted to: {dest}")
