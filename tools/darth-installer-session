#!/usr/bin/env bash
set -uo pipefail
VERSION="$(cat /etc/darth-linux-release 2>/dev/null || printf '0.5')"
clear
printf '\033[1;31m'
cat <<'BANNER'
██████╗  █████╗ ██████╗ ████████╗██╗  ██╗
██╔══██╗██╔══██╗██╔══██╗╚══██╔══╝██║  ██║
██║  ██║███████║██████╔╝   ██║   ███████║
██║  ██║██╔══██║██╔══██╗   ██║   ██╔══██║
██████╔╝██║  ██║██║  ██║   ██║   ██║  ██║
╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═╝   ╚═╝   ╚═╝  ╚═╝
BANNER
printf '\033[0m'
printf 'DARTH LINUX %s  //  SYSTEM INSTALLER\n' "$VERSION"
printf 'The installer engine is Archinstall; Darth Linux keeps Arch underneath.\n\n'
printf 'Review the target disk, partition layout, bootloader and encryption settings carefully.\n'
printf 'Selecting a disk can erase its data. Back up anything important first.\n\n'
read -r -p 'Press Enter to launch the installer, or Ctrl+C to cancel... '
if [[ $EUID -eq 0 ]]; then
  archinstall
else
  sudo archinstall
fi
status=$?
printf '\nDarth Installer finished with exit code %s.\n' "$status"
if [[ $status -eq 0 ]]; then
  printf '\nNEXT STEP — INSTALL THE DARTH DESKTOP ON YOUR NEW SYSTEM\n'
  printf 'After rebooting into the installed system and connecting to the internet, run:\n\n'
  printf '  sudo pacman -Syu --needed git\ngit clone https://github.com/Screwyougucci/DarthLinux.git\n'
  printf '  cd DarthLinux\n'
  printf '  sudo bash scripts/install-custom-tools.sh\n\n'
  printf 'This installs the Darth 0.5 desktop, applications, firewall defaults and Update Center.\n'
fi
read -r -p 'Press Enter to close this window... ' _
exit "$status"
